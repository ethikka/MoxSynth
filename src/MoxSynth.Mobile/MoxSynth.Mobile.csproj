<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MoxSynth for Android (.NET MAUI). Talks to the MoxSynth server's JSON API (/api); all logic lives in
    MoxSynth.Client (view models, API client), this project adds pages and Android services.
    Requires the MAUI Android workload:  dotnet workload install maui-android
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MoxSynth.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>MoxSynth</ApplicationTitle>
    <ApplicationId>com.ethikka.moxsynth</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B1530" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B1530" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- On-device text recognition (Google ML Kit) for scanning cards. -->
    <PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoxSynth.Client\MoxSynth.Client.csproj" />
  </ItemGroup>

</Project>
