<?xml version="1.0" encoding="utf-8" ?>
<pages:ViewModelPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:pages="clr-namespace:MoxSynth.Mobile.Pages"
                     xmlns:vm="clr-namespace:MoxSynth.Client.ViewModels;assembly=MoxSynth.Client"
                     x:Class="MoxSynth.Mobile.Pages.HistoryPage"
                     x:DataType="vm:HistoryViewModel"
                     Title="History">
    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Error}" Style="{StaticResource Error}" IsVisible="{Binding HasError}" Margin="14,6" />
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Events}" RemainingItemsThreshold="10"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryItem">
                        <Border Style="{StaticResource Row}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEventTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6">
                                <Label Text="{Binding Symbol}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAdded}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeOk}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsAdded}" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeBad}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding When}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Nothing added or removed yet." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Padding="30" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</pages:ViewModelPage>
