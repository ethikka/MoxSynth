@if (TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">
            <li class="page-item @(Page <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page - 1)">‹ Prev</button>
            </li>
            @foreach (var p in VisiblePages())
            {
                if (p == 0)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    var pageNum = p;
                    <li class="page-item @(pageNum == Page ? "active" : "")">
                        <button class="page-link" @onclick="() => Go(pageNum)">@pageNum</button>
                    </li>
                }
            }
            <li class="page-item @(Page >= TotalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page + 1)">Next ›</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private async Task Go(int page)
    {
        if (page < 1 || page > TotalPages || page == Page) return;
        await PageChanged.InvokeAsync(page);
    }

    // 0 = ellipsis
    private IEnumerable<int> VisiblePages()
    {
        var pages = new SortedSet<int> { 1, TotalPages };
        for (var i = Page - 2; i <= Page + 2; i++)
            if (i >= 1 && i <= TotalPages) pages.Add(i);

        var prev = 0;
        foreach (var p in pages)
        {
            if (prev != 0 && p - prev > 1) yield return 0;
            yield return p;
            prev = p;
        }
    }
}
