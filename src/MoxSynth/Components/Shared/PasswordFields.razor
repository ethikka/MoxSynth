@* New password + confirmation inputs for plain HTML forms (names: password, confirm). *@
<label class="form-label small mb-0 mt-3" for="@($"{Prefix}-password")">@Label</label>
<input id="@($"{Prefix}-password")" name="password" type="password" class="form-control" required
       minlength="@PasswordHashing.MinimumLength" autocomplete="new-password" />
<label class="form-label small mb-0 mt-2" for="@($"{Prefix}-confirm")">Repeat password</label>
<input id="@($"{Prefix}-confirm")" name="confirm" type="password" class="form-control" required
       minlength="@PasswordHashing.MinimumLength" autocomplete="new-password" />
<div class="form-text">At least @PasswordHashing.MinimumLength characters.</div>

@code {
    [Parameter] public string Label { get; set; } = "Password";
    [Parameter] public string Prefix { get; set; } = "new";
}
