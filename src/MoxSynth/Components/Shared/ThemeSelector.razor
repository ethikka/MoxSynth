@inject IJSRuntime JS

<select class="form-select form-select-sm theme-select" aria-label="Theme" title="Theme"
        value="@_theme" @onchange="OnChangeAsync">
    @foreach (var (group, themes) in Groups)
    {
        <optgroup label="@group">
            @foreach (var (value, label) in themes)
            {
                <option value="@value">@label</option>
            }
        </optgroup>
    }
</select>

@code {
    // Keep in sync with THEMES in wwwroot/theme.js.
    private static readonly (string Group, (string Value, string Label)[] Themes)[] Groups =
    [
        ("Basic", [("system", "◐ System"), ("light", "☀ Light"), ("dark", "☾ Dark")]),
        ("Seasons", [("seasonal", "↻ Season (automatic)"), ("spring", "✿ Spring"), ("summer", "☼ Summer"),
                     ("autumn", "❦ Autumn"), ("winter", "❄ Winter")]),
        ("Special", [("neon", "⚡ Neon"), ("halloween", "☠ Halloween"), ("steampunk", "⚙ Steampunk"),
                     ("cyberpunk", "⌁ Cyberpunk")]),
    ];

    private string _theme = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _theme = await JS.InvokeAsync<string>("moxTheme.get");
        StateHasChanged();
    }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        _theme = e.Value?.ToString() ?? "system";
        await JS.InvokeVoidAsync("moxTheme.set", _theme);
    }
}
