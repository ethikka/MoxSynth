<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["scanner.js"]" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Creepster&family=Cinzel:wght@600;700&family=Rajdhani:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mana-font@1.18.0/css/mana.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/keyrune@3.19.0/css/keyrune.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["themes.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" ProfileId="@ProfileId" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [Inject] private MoxSynth.Profiles.ProfileStore Profiles { get; set; } = default!;

    // The sign-in cookie can only be read here (static render with HttpContext); the profile id is passed on to
    // the interactive Routes component, which stores it in the circuit's CurrentProfile.
    private long? ProfileId => MoxSynth.Profiles.ProfileEndpoints.GetSignedInProfile(HttpContext, Profiles)?.Id;
}
