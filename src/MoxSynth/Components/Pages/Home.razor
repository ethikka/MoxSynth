@page "/"
@inject CollectionRepository Collection
@inject CardRepository Cards
@inject PriceRepository Prices
@inject PriceSettings PriceSettings

<PageTitle>MoxSynth</PageTitle>

<h1 class="h3 mb-3">Dashboard</h1>

@if (_stats is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="row g-3 mb-4">
        <StatTile Label="Cards owned" Value="@_stats.OwnedCopies" />
        <StatTile Label="Unique printings" Value="@_stats.UniquePrintings" />
        <StatTile Label="Unique card names" Value="@_stats.UniqueNames" />
        <StatTile Label="Added (30 days)" Value="@_stats.AddedLast30Days" />
        <StatTile Label="Removed (30 days)" Value="@_stats.RemovedLast30Days" />
        <StatTile Label="Removed (all time)" Value="@_stats.RemovedCopies" />
    </div>
    @if (_value?.TotalValue is { } total)
    {
        <div class="card card-body mb-4 d-flex flex-row flex-wrap align-items-baseline gap-3">
            <div>
                <div class="text-muted small">Estimated collection value (@PriceProviders.Label(PriceSettings.Provider))</div>
                <div class="stat-value">@(PriceProviders.CurrencySymbol(_value.Currency))@total.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</div>
            </div>
            <div class="small text-body-secondary">
                @if (_value.UnpricedCopies > 0)
                {
                    <span>@_value.UnpricedCopies.ToString("N0") cards without a price. </span>
                }
                <a href="collection">Most valuable cards →</a>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-baseline">
        <h2 class="h5">Recent activity</h2>
        <a href="history" class="small">Full history →</a>
    </div>
    @if (_recent.Count == 0)
    {
        <div class="alert alert-light">No cards yet. <a href="search">Search for cards</a> to add your first one.</div>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var e in _recent)
            {
                <li class="list-group-item d-flex justify-content-between small">
                    <span>
                        <span class="badge @(e.Kind == "Added" ? "text-bg-success" : "text-bg-secondary") me-2">@e.Kind</span>
                        <a href="card/@e.CardUuid">@e.Name</a>
                        <span class="text-muted">(@e.SetCode #@e.Number, @CardFinishes.Label(e.Finish))</span>
                    </span>
                    <span class="text-muted">@SqliteTime.Display(e.At)</span>
                </li>
            }
        </ul>
    }

    @if (_meta is not null)
    {
        <p class="text-muted small">Card database: MTGJSON @_meta.Version (@_meta.Date)</p>
    }
}

@code {
    private CollectionStats? _stats;
    private IReadOnlyList<HistoryEvent> _recent = [];
    private CardDbMeta? _meta;
    private CollectionPage? _value;

    protected override async Task OnInitializedAsync()
    {
        _stats = await Collection.GetStatsAsync();
        _recent = (await Collection.GetHistoryAsync(1, 10)).Items;
        _meta = await Cards.GetMetaAsync();
        if (Prices.IsAvailable) _value = await Collection.GetValueAsync(PriceSettings.Provider);
    }
}
